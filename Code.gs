function setEventPublished(token,id,published){const user=assertAdmin_(token),s=sheet_('settingsDb','Events'),v=s.getDataRange().getValues();for(let i=1;i<v.length;i++)if(String(v[i][0]).trim()===String(id).trim()){if(bool_(published)&&String(v[i][1]).trim()!=='saved')throw new Error('下書きは公開できません。');s.getRange(i+1,3).setValue(bool_(published));s.getRange(i+1,21,1,2).setValues([[new Date(),user]]);SpreadsheetApp.flush();return{ok:true,published:bool_(published)}}throw new Error('予定が見つかりません。')}
